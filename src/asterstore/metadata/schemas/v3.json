{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asterstore managed protocol v3",
  "$comment": "Structural validation only. See docs/protocol-v3.md for codec and lifecycle invariants. No schema loading occurs on the ordinary read path.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "$comment": "The codec additionally enforces at most 4096 UTF-8 bytes, without normalization."
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^:\\\\\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff/]+(?:/[^:\\\\\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff/]+)*$",
      "$comment": "The codec also requires printable characters (Python str.isprintable)."
    },
    "managed_key": {
      "allOf": [
        {
          "$ref": "#/$defs/key"
        },
        {
          "pattern": "^\\.asterstore/objects/[0-9a-f]{32}/.+$"
        }
      ]
    },
    "private_key": {
      "allOf": [
        {
          "$ref": "#/$defs/key"
        },
        {
          "pattern": "^\\.asterstore/(?:objects/[0-9a-f]{32}/|candidates/[0-9a-f]{32}/files/).+$"
        }
      ],
      "$comment": "The namespace token must equal the owning candidate_id; checked by the codec."
    },
    "dataset": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/identifier"
        },
        "physical_history": {
          "enum": [
            "current_only",
            "versioned"
          ]
        }
      },
      "required": [
        "dataset_id",
        "physical_history"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "repository"
        }
      },
      "required": [
        "format_version",
        "kind"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "candidate"
        },
        "candidate_id": {
          "$ref": "#/$defs/token"
        },
        "dataset": {
          "$ref": "#/$defs/dataset"
        },
        "publication_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 0
        },
        "keys": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/key"
              },
              "uniqueItems": true,
              "minItems": 0
            }
          ]
        },
        "reused_objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/managed_key"
              },
              "publication_id": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [
              "key",
              "publication_id"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "format_version",
        "kind",
        "candidate_id",
        "dataset",
        "publication_id",
        "expected_generation",
        "keys",
        "reused_objects"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "publication"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/token"
        },
        "publication": {
          "type": "object",
          "properties": {
            "dataset": {
              "$ref": "#/$defs/dataset"
            },
            "publication_id": {
              "$ref": "#/$defs/identifier"
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/$defs/managed_key"
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              },
              "uniqueItems": true,
              "minItems": 0
            }
          },
          "required": [
            "dataset",
            "publication_id",
            "objects"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format_version",
        "kind",
        "generation",
        "candidate_id",
        "publication"
      ],
      "additionalProperties": false
    },
    "retention_reference": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "retention_reference"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "dataset_id": {
          "$ref": "#/$defs/identifier"
        },
        "publication_id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "active",
            "released"
          ]
        },
        "selection": {
          "enum": [
            "current",
            "publication"
          ]
        }
      },
      "required": [
        "format_version",
        "kind",
        "name",
        "dataset_id",
        "publication_id",
        "revision",
        "state",
        "selection"
      ],
      "additionalProperties": false
    },
    "retired_publication": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "retired_publication"
        },
        "dataset": {
          "$ref": "#/$defs/dataset"
        },
        "publication_id": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/token"
        },
        "collection_id": {
          "$ref": "#/$defs/token"
        }
      },
      "required": [
        "format_version",
        "kind",
        "dataset",
        "publication_id",
        "generation",
        "candidate_id",
        "collection_id"
      ],
      "additionalProperties": false
    },
    "collection_plan": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "collection_plan"
        },
        "operation_id": {
          "$ref": "#/$defs/token"
        },
        "policy": {
          "type": "object",
          "properties": {
            "datasets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "keep_last": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "datasets",
            "keep_last"
          ],
          "additionalProperties": false
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publication"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/managed_key"
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "format_version",
        "kind",
        "operation_id",
        "policy",
        "targets",
        "objects"
      ],
      "additionalProperties": false
    },
    "collection_progress": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "collection_progress"
        },
        "operation_id": {
          "$ref": "#/$defs/token"
        },
        "state": {
          "enum": [
            "planned",
            "running",
            "blocked",
            "complete"
          ]
        },
        "retired": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "deleted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/managed_key"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/managed_key"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "protected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/managed_key"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "format_version",
        "kind",
        "operation_id",
        "state",
        "retired",
        "deleted",
        "missing",
        "protected",
        "issues"
      ],
      "additionalProperties": false
    },
    "abandoned_candidate": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "abandoned_candidate"
        },
        "manifest": {
          "$ref": "#/$defs/candidate"
        }
      },
      "required": [
        "format_version",
        "kind",
        "manifest"
      ],
      "additionalProperties": false
    },
    "candidate_cleanup_plan": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "candidate_cleanup_plan"
        },
        "candidate_id": {
          "$ref": "#/$defs/token"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/private_key"
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "format_version",
        "kind",
        "candidate_id",
        "keys"
      ],
      "additionalProperties": false
    },
    "candidate_cleanup_progress": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "const": "candidate_cleanup_progress"
        },
        "candidate_id": {
          "$ref": "#/$defs/token"
        },
        "complete": {
          "type": "boolean"
        },
        "deleted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/private_key"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/private_key"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "format_version",
        "kind",
        "candidate_id",
        "complete",
        "deleted",
        "missing",
        "issues"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/repository"
    },
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/publication"
    },
    {
      "$ref": "#/$defs/retention_reference"
    },
    {
      "$ref": "#/$defs/retired_publication"
    },
    {
      "$ref": "#/$defs/collection_plan"
    },
    {
      "$ref": "#/$defs/collection_progress"
    },
    {
      "$ref": "#/$defs/abandoned_candidate"
    },
    {
      "$ref": "#/$defs/candidate_cleanup_plan"
    },
    {
      "$ref": "#/$defs/candidate_cleanup_progress"
    }
  ]
}
