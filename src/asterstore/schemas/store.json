{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AsterStore directory transactions, format 4",
  "$defs": {
    "state": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "undo": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "operation",
        "publication",
        "metadata",
        "undo"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "const": 4
        },
        "kind": {
          "const": "registry"
        },
        "datasets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "format",
        "kind",
        "datasets"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": 4
        },
        "kind": {
          "const": "dataset"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "before": {
          "$ref": "#/$defs/state"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "existed": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "existed"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "before",
        "entries"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "publish",
            "rollback"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "before": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "kind",
        "id",
        "source",
        "before"
      ],
      "additionalProperties": false
    }
  ]
}
